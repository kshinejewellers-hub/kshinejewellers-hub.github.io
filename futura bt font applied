<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<title>KSHINE JEWELLERS</title>
<meta name="viewport" content="width=device-width, initial-scale=1">

<style>

/* ==================================================
STYLE 1 – FONTS
================================================== */
@font-face{
  font-family:'ErasDemi';
  src:url('eras-demi-itc.ttf');
}
@font-face{
  font-family:'FuturaBold';
  src:url('futuraboldbt.ttf');
}

/* ==================================================
STYLE 2 – COLOUR SYSTEM
================================================== */
:root{
  --gold:#d4af37;
  --gold-dark:#9c7a19;
  --gold-light:#fff3c4;
  --green:#8fd19e;
  --text:#222;
}

/* ==================================================
STYLE 3 – BODY & BACKGROUND
================================================== */
body{
  margin:0;
  font-family:Arial, sans-serif;
  background:url('bgimage.jpg') center/cover fixed no-repeat;
}

/* ==================================================
STYLE 4 – MAIN WRAPPER
================================================== */
.wrapper{
  max-width:430px;
  margin:10px auto 120px;
  background:#fff;
  border-radius:24px;
  box-shadow:0 20px 50px rgba(0,0,0,.3);
  overflow:hidden;
}

/* ==================================================
STYLE 5 – TOP SCROLLER
================================================== */
.scroller{
  background:#000;
  color:#ffd700;
  font-size:13px;
  font-style:italic;
  padding:6px 0;
  white-space:nowrap;
  overflow:hidden;
}
.scroller span{
  display:inline-block;
  padding-left:100%;
  animation:scroll 9s linear infinite;
}
@keyframes scroll{
  0%{transform:translateX(0);}
  100%{transform:translateX(-100%);}
}

/* ==================================================
STYLE 6 – BANNER & DP
================================================== */
.banner{
  height:230px;
  background:url('bannerimage.png') center/cover no-repeat;
  position:relative;
}
.dp{
  position:absolute;
  bottom:-55px;
  width:100%;
  display:flex;
  justify-content:center;
}
.dp img{
  width:110px;
  height:110px;
  border-radius:50%;
  border:6px solid #fff;
  box-shadow:0 12px 30px rgba(0,0,0,.4);
}

/* ==================================================
STYLE 7 – CONTENT AREA
================================================== */
.content{
  padding:75px 16px 24px;
  text-align:center;
}

/* ==================================================
STYLE 8 – BRAND NAME
================================================== */
.brand{
  font-family:'ErasDemi';
  font-size:26px;
  color:var(--gold-dark);
  letter-spacing:1px;
}

/* ==================================================
STYLE 9 – TOGGLES
================================================== */
.toggles{
  display:flex;
  justify-content:center;
  gap:10px;
  margin:10px 0;
}
.toggle{
  background:#000;
  color:var(--gold);
  padding:6px 14px;
  border-radius:18px;
  font-size:13px;
  font-weight:700;
}

/* ==================================================
STYLE 10 – TAGLINE
================================================== */
.tag{
  font-style:italic;
  font-weight:600;
  color:#555;
  margin:10px 0 16px;
}

/* ==================================================
STYLE 11 – RATINGS TITLE
================================================== */
.rating-title{
  font-family:'ErasDemi';
  margin:12px 0;
}

/* ==================================================
STYLE 12 – GOOGLE RATING CARDS
================================================== */
.ratings{
  display:flex;
  gap:12px;
}
.rate{
  flex:1;
  background:var(--gold-light);
  border:3px solid var(--gold);
  border-radius:18px;
  padding:12px;
  cursor:pointer;
}
.rate .stars{
  color:var(--gold-dark);
  font-size:16px;
}
.rate .score{
  font-family:'FuturaBold';
  font-size:18px;
  font-weight:900;
}
.rate .place{
  font-family:'FuturaBold';
  font-size:16px;
  font-weight:900;
}
.rate .reviews{
  font-family:'FuturaBold';
  font-style:italic;
  font-weight:400;
}

/* ==================================================
STYLE 13 – CALL / WHATSAPP BUTTONS
================================================== */
.actions{
  display:flex;
  gap:10px;
  margin:14px 0;
}
.action{
  flex:1;
  padding:14px;
  background:var(--green);
  border-radius:16px;
  font-weight:800;
  font-family:'FuturaBold';
}

/* ==================================================
STYLE 14 – WEBSITE BUTTON
================================================== */
.website-btn{
  background:linear-gradient(135deg,var(--gold),var(--gold-dark));
  padding:14px;
  border-radius:16px;
  font-weight:900;
  font-family:'FuturaBold';
  margin-bottom:14px;
}

/* ==================================================
STYLE 15 – SOCIAL MEDIA GRID
================================================== */
.social{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:10px;
}
.social a{
  padding:10px;
  border-radius:12px;
  border:2px solid var(--gold);
  font-weight:700;
  font-family:'FuturaBold';
}

/* ==================================================
STYLE 16 – ADDRESS BOX
================================================== */
.address{
  background:#fff4c2;
  border:2px solid var(--gold);
  border-radius:16px;
  padding:12px;
  font-size:13px;
  margin-top:14px;
}
.address b,
.address a{
  font-family:'FuturaBold';
  color:inherit;
  text-decoration:none;
}

/* ==================================================
STYLE 17 – QR SCANNER
================================================== */
.qr{
  margin-top:18px;
  background:#000;
  border:4px solid var(--gold);
  border-radius:18px;
  padding:12px;
}
.qr img{
  width:100%;
}
.qr p{
  color:var(--gold);
  font-family:'ErasDemi';
  font-size:12px;
}

/* ==================================================
STYLE 18 – FLOATING BUTTONS
================================================== */
.floating{
  position:fixed;
  bottom:10px;
  left:50%;
  transform:translateX(-50%);
  display:flex;
  gap:10px;
  width:90%;
  max-width:420px;
  z-index:9999;
}
.float-btn{
  flex:1;
  background:#5b3a00;
  color:#ffd700;
  padding:14px;
  border-radius:18px;
  font-family:'FuturaBold';
  font-weight:900;
}

</style>
</head>

