<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<title>KSHINE JEWELLERS</title>
<meta name="viewport" content="width=device-width, initial-scale=1">

<!-- ==================================================
STYLE 1 – FONTS
================================================== -->
<style>
@font-face {
  font-family: 'ErasDemi';
  src: url('eras-demi-itc.ttf');
}
@font-face {
  font-family: 'FuturaBold';
  src: url('futuraboldbt.ttf');
}

/* ==================================================
STYLE 2 – COLOUR SYSTEM
================================================== */
:root{
  --gold:#d4af37;
  --gold-dark:#9c7a19;
  --gold-light:#fff3c4;
  --green:#8fd19e;
  --green-dark:#6fcf97;
  --text:#222;
}

/* ==================================================
STYLE 3 – BODY & BACKGROUND
================================================== */
body{
  margin:0;
  font-family: Arial, sans-serif;
  background:url('bgimage.jpg') center/cover fixed no-repeat;
}

/* ==================================================
STYLE 4 – MAIN WRAPPER
================================================== */
.wrapper{
  max-width:430px;
  margin:10px auto 140px;
  background:#fff;
  border-radius:24px;
  box-shadow:0 20px 50px rgba(0,0,0,.35);
  overflow:hidden;
}

/* ==================================================
STYLE 5 – TOP SCROLLER
================================================== */
.scroller{
  background:#000;
  color:#ffd700;
  font-size:13px;
  font-style:italic;
  padding:6px 0;
  white-space:nowrap;
  overflow:hidden;
}
.scroller span{
  display:inline-block;
  padding-left:100%;
  animation:scroll 8s linear infinite;
}
@keyframes scroll{
  0%{transform:translateX(0);}
  100%{transform:translateX(-100%);}
}

/* ==================================================
STYLE 6 – BANNER & DP
================================================== */
.banner{
  height:230px;
  background:url('bannerimage.png') center/cover no-repeat;
  position:relative;
}
.dp{
  position:absolute;
  bottom:-55px;
  width:100%;
  display:flex;
  justify-content:center;
}
.dp img{
  width:110px;
  height:110px;
  border-radius:50%;
  border:6px solid #fff;
  box-shadow:0 12px 30px rgba(0,0,0,.45);
}

/* ==================================================
STYLE 7 – CONTENT AREA
================================================== */
.content{
  padding:75px 16px 24px;
  text-align:center;
}

/* ==================================================
STYLE 8 – BRAND NAME (SHIMMER)
================================================== */
.brand{
  font-family:'ErasDemi';
  font-size:26px;
  color:var(--gold-dark);
  letter-spacing:1px;
  position:relative;
  overflow:hidden;
}
.brand::after{
  content:'';
  position:absolute;
  top:0;
  left:-100%;
  width:100%;
  height:100%;
  background:linear-gradient(120deg,transparent,rgba(255,215,120,.9),transparent);
  animation:shine 3s infinite;
}
@keyframes shine{
  0%{left:-100%}
  50%{left:100%}
  100%{left:100%}
}

/* ==================================================
STYLE 9 – TAGLINE (PULSE)
================================================== */
.tag{
  font-style:italic;
  font-weight:600;
  color:#555;
  margin:10px 0 16px;
  animation:pulse 3s infinite;
}
@keyframes pulse{
  0%,100%{opacity:.9}
  50%{opacity:.55}
}

/* ==================================================
STYLE 10 – RATINGS TITLE
================================================== */
.rating-title{
  font-family:'ErasDemi';
  margin:12px 0;
}

/* ==================================================
STYLE 11 – GOOGLE RATING CARDS
================================================== */
.ratings{
  display:flex;
  gap:12px;
}
.rate{
  flex:1;
  background:var(--gold-light);
  border:3px solid var(--gold);
  border-radius:18px;
  padding:12px;
  cursor:pointer;
  box-shadow:0 8px 18px rgba(0,0,0,.25);
  transition:transform .2s ease;
}
.rate:active{
  transform:scale(.97);
}
.rate .tap{
  font-size:12px;
  opacity:.7;
}
.rate .stars{
  color:var(--gold-dark);
  font-size:18px;
}
.rate .score{
  font-size:20px;
  font-weight:900;
}
.rate .place{
  font-family:'FuturaBold';
  font-size:18px;
}
.rate .reviews{
  font-style:italic;
  font-size:14px;
}

/* ==================================================
STYLE 12 – SAVE CONTACT BUTTON
================================================== */
.save-btn{
  background:linear-gradient(135deg,#6b4b00,#3e2a00);
  color:#ffd700;
  padding:14px;
  border-radius:16px;
  font-family:'FuturaBold';
  font-weight:900;
  border:2px solid var(--gold);
  margin:14px 0;
}

/* ==================================================
STYLE 13 – CALL / WHATSAPP
================================================== */
.actions{
  display:flex;
  gap:10px;
}
.action{
  flex:1;
  padding:14px;
  background:var(--green);
  border-radius:16px;
  font-family:'FuturaBold';
  font-weight:800;
  color:#000;
}

/* ==================================================
STYLE 14 – WEBSITE BUTTON
================================================== */
.website-btn{
  background:linear-gradient(135deg,var(--gold),var(--gold-dark));
  padding:14px;
  border-radius:16px;
  font-family:'FuturaBold';
  font-weight:900;
  margin:14px 0;
}

/* ==================================================
STYLE 15 – SOCIAL MEDIA GRID
================================================== */
.social{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}
.social a{
  padding:10px;
  background:var(--gold-light);
  border:2px solid var(--gold);
  border-radius:12px;
  font-family:'FuturaBold';
  color:#000;
  text-decoration:none;
}

/* ==================================================
STYLE 16 – ADDRESS
================================================== */
.address{
  background:var(--gold-light);
  border:2px solid var(--gold);
  border-radius:16px;
  padding:12px;
  font-family:'FuturaBold';
  margin-top:14px;
}
.address a{
  color:#000;
  text-decoration:none;
}

/* ==================================================
STYLE 17 – QR SCANNER
================================================== */
.qr{
  margin-top:16px;
  background:#000;
  border:3px solid var(--gold);
  border-radius:16px;
  padding:14px;
}
.qr img{
  width:160px;
}
.qr p{
  color:var(--gold);
  font-family:'ErasDemi';
  font-size:12px;
}

/* ==================================================
STYLE 18 – FLOATING BUTTONS
================================================== */
.floating{
  position:fixed;
  bottom:10px;
  left:50%;
  transform:translateX(-50%);
  display:flex;
  gap:10px;
  width:90%;
  max-width:420px;
  z-index:9999;
}
.float-btn{
  flex:1;
  background:#5b3a00;
  color:#ffd700;
  padding:14px;
  border-radius:18px;
  font-family:'FuturaBold';
  border:2px solid var(--gold);
}
</style>
</head>

